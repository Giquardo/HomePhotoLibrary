# Copy to .env and fill in real values. Never commit .env.
# ASP.NET Core maps double-underscore env vars to nested config sections,
# e.g. ConnectionStrings__DefaultConnection -> ConnectionStrings:DefaultConnection.

# MySQL credentials for the docker-compose "db" service. docker-compose.yml
# builds the api container's connection string from these directly, so the
# password only needs to be set once here.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=photoalbum
MYSQL_USER=photoalbum
MYSQL_PASSWORD=

# Only needed for local non-compose `dotnet run` dev, where there's no db
# service to build a connection string from automatically.
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=photoalbum;Uid=photoalbum;Pwd=changeme;

# JWT signing key. Must be a random value >= 32 bytes (256 bits) for HMAC-SHA256.
# Generate one with: openssl rand -base64 48
Jwt__Key=
Jwt__Issuer=PhotoAlbumApi
Jwt__Audience=PhotoAlbumApi

# Admin account bootstrapped on first startup, only if the Users table is
# empty. There is no open registration; ADMIN_PASSWORD must be >= 12 chars.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Comma-separated browser origins allowed to call the API (CORS). Defaults to
# the local dev origins if unset. In the proxied Phase 3 setup this can be
# tightened to just the proxy's own origin.
Cors__AllowedOrigins=

# Directories for uploaded photos and log files. Relative paths resolve
# against the container WORKDIR (/app); mount volumes at the same path.
Storage__BasePath=
Logging__BasePath=

# Hostname LAN clients use to reach this host (Caddyfile). Defaults to
# "localhost" if unset. Set to a real domain to expose this to the internet
# (also remove "tls internal" from the Caddyfile to get a real cert via ACME).
SITE_ADDRESS=

# How many days of nightly DB/image backups to keep in ./backups before the
# backup service prunes older ones. See BACKUP.md.
BACKUP_RETENTION_DAYS=14
