@page "/update-user/{userId:int}"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ILocalStorageService LocalStorage
@using Blazored.LocalStorage

<h3>Update User</h3>

@if (isSelf)
{
    <div class="alert alert-info">This is your own account - it can be edited but not deleted from here.</div>
}

<EditForm Model="editUser" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label for="username">Username</label>
        <InputText id="username" class="form-control" @bind-Value="editUser.Username" />
    </div>

    <div class="form-group">
        <label for="email">Email</label>
        <InputText id="email" class="form-control" @bind-Value="editUser.Email" />
    </div>

    <div class="form-group">
        <label for="password">Password</label>
        <InputText id="password" type="password" class="form-control" @bind-Value="editUser.Password" />
        <p class="hint">Leave blank to keep the current password. At least 12 characters if changing it.</p>
    </div>

    <div class="form-group checkbox-group">
        <label>
            <InputCheckbox @bind-Value="editUser.IsAdmin" />
            Admin
        </label>
    </div>

    <button type="submit" class="btn btn-primary">Update User</button>
    <button type="button" class="btn btn-danger" disabled="@isSelf" @onclick="RequestDelete">Delete User</button>
</EditForm>

@if (confirmingDelete)
{
    <div class="confirm-delete">
        <span>Delete this user permanently?</span>
        <button class="btn btn-danger" @onclick="ConfirmDelete">Confirm</button>
        <button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<style>
    .form-group {
        margin-bottom: 15px;
    }

    .form-control {
        width: 100%;
        padding: 10px;
        box-sizing: border-box;
    }

    .checkbox-group label {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .hint {
        margin: 4px 0 0;
        color: #777;
        font-size: 0.85rem;
    }

    .btn {
        padding: 10px 20px;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        margin-right: 10px;
    }

    .btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .btn-primary {
        background-color: #007bff;
    }

    .btn-primary:hover {
        background-color: #0056b3;
    }

    .btn-danger {
        background-color: #dc3545;
    }

    .btn-danger:hover {
        background-color: #c82333;
    }

    .btn-secondary {
        background-color: #6c757d;
    }

    .confirm-delete {
        margin-top: 15px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .alert {
        margin-top: 20px;
    }

    .alert-info {
        background-color: #d1ecf1;
        color: #0c5460;
        padding: 10px;
        border-radius: 5px;
        margin-bottom: 15px;
    }
</style>

@code {
    [Parameter]
    public int UserId { get; set; }

    private UserFormModel editUser = new();
    private string? errorMessage;
    private bool isSelf;
    private bool confirmingDelete;

    protected override async Task OnInitializedAsync()
    {
        var token = await LocalStorage.GetItemAsync<string>("authToken");
        if (string.IsNullOrEmpty(token))
        {
            Navigation.NavigateTo("/login");
            return;
        }
        if (!JwtClaimsHelper.IsAdmin(token))
        {
            Navigation.NavigateTo("/albums");
            return;
        }

        isSelf = JwtClaimsHelper.GetUserId(token) == UserId;

        Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        try
        {
            var user = await Http.GetFromJsonAsync<UserDisplayDto>($"api/users/{UserId}");
            if (user != null)
            {
                editUser.Username = user.Username;
                editUser.Email = user.Email;
                editUser.IsAdmin = user.IsAdmin;
            }
        }
        catch (Exception ex) when (ex.IsUnauthorized())
        {
            await AuthErrorHelper.HandleUnauthorizedAsync(LocalStorage, Navigation);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task HandleValidSubmit()
    {
        var token = await LocalStorage.GetItemAsync<string>("authToken");
        if (string.IsNullOrEmpty(token))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        var response = await Http.PutAsJsonAsync($"api/users/{UserId}", editUser);

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/users");
        }
        else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            await AuthErrorHelper.HandleUnauthorizedAsync(LocalStorage, Navigation);
        }
        else
        {
            errorMessage = $"Failed to update user ({(int)response.StatusCode}).";
        }
    }

    private void RequestDelete() => confirmingDelete = true;
    private void CancelDelete() => confirmingDelete = false;

    private async Task ConfirmDelete()
    {
        var token = await LocalStorage.GetItemAsync<string>("authToken");
        if (string.IsNullOrEmpty(token))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        var response = await Http.DeleteAsync($"api/users/{UserId}");

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/users");
        }
        else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            await AuthErrorHelper.HandleUnauthorizedAsync(LocalStorage, Navigation);
        }
        else
        {
            errorMessage = $"Failed to delete user ({(int)response.StatusCode}).";
            confirmingDelete = false;
        }
    }

    public class UserFormModel
    {
        public string Username { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string? Password { get; set; }
        public bool IsAdmin { get; set; } = false;
    }

    public class UserDisplayDto
    {
        public int Id { get; set; }
        public string Username { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public bool IsAdmin { get; set; }
    }
}
